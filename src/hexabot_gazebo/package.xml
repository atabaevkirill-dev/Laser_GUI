<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexabot_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic simulation of Hexabot on the scout test range (day and night).</description>
  <maintainer email="atabaevkirill@gmail.com">Kirill Atabaev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hexabot_description</exec_depend>
  <exec_depend>hexabot_bringup</exec_depend>
  <exec_depend>hexabot_locomotion</exec_depend>
  <exec_depend>hexabot_lrf</exec_depend>
  <exec_depend>hexabot_illuminator</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
