<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexabot_illuminator</name>
  <version>0.1.0</version>
  <description>Driver for the IR laser illuminator (TCP or serial, FF-addressed 7-byte protocol of the former Laser_GUI).</description>
  <maintainer email="atabaevkirill@gmail.com">Kirill Atabaev</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>hexabot_interfaces</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
