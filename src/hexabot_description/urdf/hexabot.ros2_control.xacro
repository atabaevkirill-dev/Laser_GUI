<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ros2_control: real STS3215 bus, mock components, or Gazebo.
       Servo IDs, directions and offsets come from config/servo_calibration.yaml. -->
  <xacro:macro name="hexabot_ros2_control" params="use_sim use_mock_hardware simulated_bus port baudrate">
    <xacro:property name="sim" value="${str(use_sim).lower() in ['true', '1']}"/>
    <xacro:property name="mock" value="${str(use_mock_hardware).lower() in ['true', '1']}"/>
    <xacro:property name="real" value="${not sim and not mock}"/>

    <ros2_control name="HexabotSystem" type="system">
      <hardware>
        <xacro:if value="${sim}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${mock}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:if value="${real}">
          <plugin>hexabot_hardware/Sts3215System</plugin>
          <param name="port">${port}</param>
          <param name="baudrate">${baudrate}</param>
          <param name="simulated_bus">${simulated_bus}</param>
          <!-- 0 = maximum acceleration; commands stream at the controller rate. -->
          <param name="acceleration">0</param>
          <param name="read_timeout_ms">6</param>
          <param name="max_consecutive_errors">50</param>
        </xacro:if>
      </hardware>

      <xacro:property name="stand_femur" value="0.408"/>
      <xacro:property name="stand_tibia" value="-0.377"/>
      <xacro:macro name="servo_joint" params="name initial">
        <xacro:property name="s" value="${calib['servos'][name]}"/>
        <joint name="${name}">
          <xacro:if value="${real}">
            <param name="id">${s['id']}</param>
            <param name="direction">${s['direction']}</param>
            <param name="offset">${s['offset']}</param>
          </xacro:if>
          <command_interface name="position"/>
          <state_interface name="position">
            <param name="initial_value">${initial}</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <xacro:if value="${real}">
            <state_interface name="temperature"/>
            <state_interface name="voltage"/>
          </xacro:if>
        </joint>
      </xacro:macro>

      <xacro:macro name="leg_joints" params="leg">
        <xacro:servo_joint name="${leg}_coxa_joint" initial="0.0"/>
        <xacro:servo_joint name="${leg}_femur_joint" initial="${stand_femur}"/>
        <xacro:servo_joint name="${leg}_tibia_joint" initial="${stand_tibia}"/>
      </xacro:macro>
      <xacro:leg_joints leg="lf"/>
      <xacro:leg_joints leg="lm"/>
      <xacro:leg_joints leg="lr"/>
      <xacro:leg_joints leg="rf"/>
      <xacro:leg_joints leg="rm"/>
      <xacro:leg_joints leg="rr"/>
      <xacro:servo_joint name="head_pan_joint" initial="0.0"/>
      <xacro:servo_joint name="head_tilt_joint" initial="0.0"/>
    </ros2_control>
  </xacro:macro>
</robot>
